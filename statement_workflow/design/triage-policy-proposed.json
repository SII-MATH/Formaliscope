{
  "schema": "triage-policy-design.v1",
  "status": "proposed_not_implemented",
  "policy_version": "triage.v1",
  "priority_order": ["P0", "P1", "P2", "P3"],
  "risk_levels": ["R0", "R1", "R2", "R3", "unknown"],
  "priority_rules": [
    {"condition": "configured_main_goal_or_mandatory_milestone", "level": "P0"},
    {"condition": "confirmed_R3_affecting_configured_goal", "level": "P0"},
    {"condition": "critical_goal_statement_definition_or_instance", "level": "P1"},
    {"condition": "goal_relevant_interpretation_or_external_assumption_boundary", "level": "P1"},
    {"condition": "goal_closure_member_with_R2_or_unknown", "level": "P1"},
    {"condition": "remaining_goal_support_or_general_review_subject", "level": "P2"},
    {"condition": "general_infrastructure_outside_goal_closures", "level": "P3"}
  ],
  "risk_rules": [
    {"condition": "confirmed_critical_semantic_discrepancy_or_degeneracy", "level": "R3", "requires": "specific_checked_evidence"},
    {"condition": "candidate_mismatch_or_material_context_gap_or_unverified_interpretation_bridge", "level": "R2", "requires": "source_or_context_evidence"},
    {"condition": "binder_instance_coercion_or_boundary_attention_signal", "level": "R1", "requires": "source_or_context_evidence"},
    {"condition": "complete_extraction_and_coverage_without_detected_signals", "level": "R0"},
    {"condition": "insufficient_analysis_or_failed_extraction", "level": "unknown"}
  ],
  "invariants": [
    "risk_is_not_probability_of_error",
    "R0_is_not_certification",
    "unknown_never_becomes_low_risk",
    "proof_status_and_semantic_risk_are_separate",
    "path_or_sorry_alone_does_not_prove_semantic_error",
    "priority_requires_goal_or_review_reason",
    "high_risk_upstream_does_not_automatically_change_downstream_intrinsic_risk",
    "machine_analysis_never_writes_human_verdicts",
    "all_reasons_require_valid_input_evidence_ids",
    "manual_overrides_preserve_original_analysis_and_version"
  ]
}
