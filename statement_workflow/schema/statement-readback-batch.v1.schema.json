{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formaliscope readback stage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "annotations"],
  "properties": {
    "schema": {"const": "formaliscope-readback-batch.v1"},
    "annotations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_id", "title_zh", "readback", "classification", "priority"],
      "properties": {
        "declaration_id": {"type": "string", "pattern": "^statement::.+", "maxLength": 1024},
        "title_zh": {"type": ["string", "null"], "minLength": 1},
        "readback": {
          "type": "object", "additionalProperties": false,
          "required": ["text_zh", "confidence"],
          "properties": {
            "text_zh": {"type": ["string", "null"], "minLength": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "classification": {
          "type": "object", "additionalProperties": false,
          "required": ["role", "topics"],
          "properties": {
            "role": {"enum": ["definition", "input", "comparison", "computation", "derivation", "target", "infrastructure", null]},
            "topics": {
              "type": "array", "uniqueItems": true, "maxItems": 100,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            }
          }
        },
        "priority": {"enum": ["p0", "p1", "p2", null]}
      }
    }
  }
}
