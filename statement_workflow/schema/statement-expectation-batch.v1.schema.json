{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formaliscope expectation stage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "annotations"],
  "properties": {
    "schema": {"const": "formaliscope-expectation-batch.v1"},
    "annotations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "$defs": {
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration_id", "expectation_assessment"],
      "properties": {
        "declaration_id": {"type": "string", "pattern": "^statement::.+", "maxLength": 1024},
        "expectation_assessment": {
          "type": "object", "additionalProperties": false,
          "required": ["verdict", "reason_zh", "confidence"],
          "properties": {
            "verdict": {"enum": ["aligned", "misaligned", "undetermined"]},
            "reason_zh": {"type": ["string", "null"], "minLength": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "allOf": [{
            "if": {"properties": {"verdict": {"enum": ["misaligned", "undetermined"]}}},
            "then": {"properties": {"reason_zh": {"type": "string", "minLength": 1}}}
          }]
        }
      }
    }
  }
}
