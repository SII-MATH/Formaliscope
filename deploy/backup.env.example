# Copy to /etc/formaliscope/backup.env (root:formaliscope-review, 0640).
# Loaded by formaliscope-review-backup.service; manual shell runs must export
# these variables separately. Counts include only complete, verified v2
# backups belonging to this data directory. Historical v1 backups are retained.
REVIEW_DATA_DIR=/var/lib/formaliscope
REVIEW_BACKUP_DIR=/var/backups/formaliscope
REVIEW_BACKUP_KEEP=30
# Custom paths also require matching systemd ReadWritePaths overrides.
# Offsite destination is intentionally unset. After a destination is chosen,
# encrypt and copy completed timestamped directories in a separate transfer
# job, then verify remote bytes and rehearse a restore before pruning remote
# copies. Never transfer the live database, sessions, pepper or recovery files.
