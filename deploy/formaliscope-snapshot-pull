#!/usr/bin/env bash
# Pull, verify, and install the latest immutable KIP126 evidence snapshot.
set -Eeuo pipefail

REPOSITORY="${FORMALISCOPE_GITHUB_REPOSITORY:-SII-MATH/Formaliscope}"
TOKEN_FILE="${FORMALISCOPE_GITHUB_TOKEN_FILE:-/etc/formaliscope/github-read-token}"
ROOT="${FORMALISCOPE_ROOT:-/opt/formaliscope}"
DATA_DIR="${REVIEW_DATA_DIR:-/var/lib/formaliscope}"
BACKUP_DIR="${REVIEW_BACKUP_DIR:-/var/backups/formaliscope}"
LOCK_FILE="${FORMALISCOPE_DEPLOY_LOCK:-/run/lock/formaliscope-deploy.lock}"
REVIEW_MODE="${FORMALISCOPE_REVIEW_MODE:-statement}"
API="https://api.github.com/repos/${REPOSITORY}/releases?per_page=100"

for path in "$ROOT" "$DATA_DIR" "$BACKUP_DIR" "$LOCK_FILE" "$TOKEN_FILE"; do
  [[ "$path" == /* ]] || { echo "deployment paths must be absolute" >&2; exit 1; }
done
# Validate, migrate and install with the selected application, not caller cwd.
cd /

[[ -r "$TOKEN_FILE" ]] || { echo "missing GitHub token file: $TOKEN_FILE" >&2; exit 1; }
[[ -L "$ROOT/current" ]] || { echo "application has not been installed: $ROOT/current" >&2; exit 1; }
install -d -m 0755 "$(dirname "$LOCK_FILE")"
install -d -o formaliscope-review -g formaliscope-review -m 0700 "$DATA_DIR" "$BACKUP_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || { echo "another Formaliscope deployment is running"; exit 0; }

token="$(<"$TOKEN_FILE")"
release_json="$(curl --fail --silent --show-error --location --retry 3 \
  -H 'Accept: application/vnd.github+json' \
  -H "Authorization: Bearer $token" \
  -H 'X-GitHub-Api-Version: 2022-11-28' "$API")"
mapfile -t release_info < <(python3 -c '
import json, re, sys
releases = json.load(sys.stdin)
chosen = None
for release in releases:
    tag = release.get("tag_name", "")
    if release.get("draft") or release.get("prerelease") or not re.fullmatch(r"snapshot-[0-9a-f]{40}", tag):
        continue
    if chosen is None or (release.get("published_at") or release.get("created_at") or "") > (chosen.get("published_at") or chosen.get("created_at") or ""):
        chosen = release
if chosen is None:
    raise SystemExit("no immutable snapshot release found")
assets = {asset["name"]: asset["url"] for asset in chosen.get("assets", [])}
required = ["snapshot.json", "snapshot.json.sha256", "snapshot-manifest.json"]
missing = [name for name in required if name not in assets]
if missing:
    raise SystemExit("release is missing assets: " + ", ".join(missing))
for value in (chosen["tag_name"], assets["snapshot.json"], assets["snapshot.json.sha256"], assets["snapshot-manifest.json"]):
    print(value)
' <<<"$release_json")

tag="${release_info[0]}"
stage="$(mktemp -d "$ROOT/.snapshot-pull.XXXXXX")"
candidate=""
cleanup() { rm -rf "$stage"; if [[ -n "$candidate" ]]; then rm -f "$candidate"; fi; }
trap cleanup EXIT
for item in snapshot.json snapshot.json.sha256 snapshot-manifest.json; do
  case "$item" in
    snapshot.json) url="${release_info[1]}";;
    snapshot.json.sha256) url="${release_info[2]}";;
    snapshot-manifest.json) url="${release_info[3]}";;
  esac
  curl --fail --silent --show-error --location --retry 3 -H 'Accept: application/octet-stream' -H "Authorization: Bearer $token" -o "$stage/$item" "$url"
done
(cd "$stage" && sha256sum -c snapshot.json.sha256)
PYTHONPATH="$(readlink -f "$ROOT/current")" \
  python3 - "$stage/snapshot-manifest.json" "$stage/snapshot.json" "$tag" "$REVIEW_MODE" <<'PY'
import json
import pathlib
import sys
from review_app.build import validate_snapshot

manifest = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
snapshot = json.loads(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8"))
validate_snapshot(snapshot)
if manifest.get("schema") != "formaliscope-snapshot-release.v1":
    raise SystemExit("unsupported snapshot manifest schema")
if manifest.get("source_commit") != sys.argv[3][len("snapshot-"):]:
    raise SystemExit("snapshot manifest source commit does not match release tag")
if manifest.get("snapshot_digest") != snapshot.get("digest"):
    raise SystemExit("snapshot manifest digest does not match snapshot")
if snapshot.get("source_commit") != manifest.get("source_commit"):
    raise SystemExit("snapshot source commit does not match manifest")
if snapshot.get("source_dirty") is not False or snapshot.get("source_origin") == "archive-unverified":
    raise SystemExit("production snapshot must come from a clean verified source checkout")
if sys.argv[4] not in {"statement", "blueprint"}:
    raise SystemExit("FORMALISCOPE_REVIEW_MODE must be statement or blueprint")
mode = snapshot.get("review_mode", "blueprint")
if mode != sys.argv[4] or manifest.get("review_mode", mode) != mode:
    raise SystemExit("snapshot review mode does not match the configured deployment")
PY

current_digest=""
if [[ -f "$DATA_DIR/snapshot.json" ]]; then
  current_digest="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("digest", ""))' "$DATA_DIR/snapshot.json")"
fi
incoming_digest="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["digest"])' "$stage/snapshot.json")"
if [[ "$current_digest" == "$incoming_digest" ]]; then
  echo "snapshot already active: $tag"
  exit 0
fi

if [[ -f "$DATA_DIR/snapshot.json" && -f "$DATA_DIR/judgments.sqlite3" ]]; then
  runuser -u formaliscope-review -- env PYTHONPATH="$(readlink -f "$ROOT/current")" REVIEW_DATA_DIR="$DATA_DIR" \
    python3 -m review_app backup --data-dir "$DATA_DIR" --output "$BACKUP_DIR"
fi
candidate="$(mktemp "$DATA_DIR/.incoming-snapshot.XXXXXX")"
install -o formaliscope-review -g formaliscope-review -m 0600 "$stage/snapshot.json" "$candidate"
runuser -u formaliscope-review -- env PYTHONPATH="$(readlink -f "$ROOT/current")" REVIEW_DATA_DIR="$DATA_DIR" \
  python3 -m review_app install-snapshot --file "$candidate" --data-dir "$DATA_DIR"
if systemctl cat formaliscope-review.service >/dev/null 2>&1; then
  systemctl restart formaliscope-review.service
  ready=0
  for attempt in {1..15}; do
    if curl --fail --silent --max-time 2 http://127.0.0.1:8765/healthz | \
      python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin).get("ready") is True else 1)' 2>/dev/null; then
      ready=1
      break
    fi
    sleep 1
  done
  [[ "$ready" == 1 ]] || { echo "snapshot readiness failed; use the documented rollback procedure" >&2; exit 1; }
fi
echo "activated snapshot $tag; digest=$incoming_digest"
