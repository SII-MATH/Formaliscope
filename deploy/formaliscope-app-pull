#!/usr/bin/env bash
# Pull and activate the latest immutable Formaliscope application release.
# A root-only GitHub token is optional for public releases and is never printed.
set -Eeuo pipefail

REPOSITORY="${FORMALISCOPE_GITHUB_REPOSITORY:-SII-MATH/Formaliscope}"
TOKEN_FILE="${FORMALISCOPE_GITHUB_TOKEN_FILE:-/etc/formaliscope/github-read-token}"
ROOT="${FORMALISCOPE_ROOT:-/opt/formaliscope}"
RELEASES="$ROOT/releases"
DATA_DIR="${REVIEW_DATA_DIR:-/var/lib/formaliscope}"
BACKUP_DIR="${REVIEW_BACKUP_DIR:-/var/backups/formaliscope}"
LOCK_FILE="${FORMALISCOPE_DEPLOY_LOCK:-/run/lock/formaliscope-deploy.lock}"
API="https://api.github.com/repos/${REPOSITORY}/releases"
RELEASE_HELPER="${FORMALISCOPE_RELEASE_HELPER:-/usr/local/sbin/formaliscope-release}"

for path in "$ROOT" "$DATA_DIR" "$BACKUP_DIR" "$LOCK_FILE" "$TOKEN_FILE" "$RELEASE_HELPER"; do
  [[ "$path" == /* ]] || { echo "deployment paths must be absolute" >&2; exit 1; }
done
# Do not allow another checkout in the caller's cwd to override PYTHONPATH.
cd /

[[ -r "$RELEASE_HELPER" ]] || { echo "install deploy/formaliscope_release.py as $RELEASE_HELPER before pulling releases" >&2; exit 1; }
install -d -m 0755 "$RELEASES" "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -n 9 || { echo "another Formaliscope deployment is running"; exit 0; }

token=''
if [[ -e "$TOKEN_FILE" || -L "$TOKEN_FILE" ]]; then
  [[ -f "$TOKEN_FILE" && -r "$TOKEN_FILE" ]] || { echo "GitHub token file is not readable: $TOKEN_FILE" >&2; exit 1; }
  token="$(<"$TOKEN_FILE")"
  [[ -n "$token" ]] || { echo "GitHub token file is empty" >&2; exit 1; }
fi
github_curl() {
  if [[ -n "$token" ]]; then
    curl --fail --silent --show-error --location --retry 3 -H "Authorization: Bearer $token" "$@"
  else
    curl --fail --silent --show-error --location --retry 3 "$@"
  fi
}
stage="$(mktemp -d "$ROOT/.app-pull.XXXXXX")"
cleanup() { rm -rf "$stage"; }
trap cleanup EXIT
# Paginate so frequent evidence snapshot releases cannot hide the app release.
page=1
while :; do
  response="$stage/releases-$page.json"
  github_curl \
    -H 'Accept: application/vnd.github+json' \
    -H 'X-GitHub-Api-Version: 2022-11-28' -o "$response" "$API?per_page=100&page=$page"
  count="$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$response")"
  [[ "$count" -lt 100 ]] && break
  page=$((page+1))
done
# Command substitution propagates selection failures before any activation.
release_details="$(python3 "$RELEASE_HELPER" select "$stage"/releases-*.json)"
release_info=()
while IFS= read -r line; do
  release_info+=("$line")
done <<<"$release_details"

tag="${release_info[0]}"
commit="${release_info[1]}"
archive_name="${release_info[2]}"
archive_url="${release_info[3]}"
sha_url="${release_info[4]}"
manifest_url="${release_info[5]}"
current_target=""
if [[ -L "$ROOT/current" ]]; then
  current_target="$(readlink -f "$ROOT/current")"
fi
if [[ "$current_target" == "$RELEASES/$commit" ]]; then
  echo "application already active: $tag"
  exit 0
fi

archive="$stage/$archive_name"
github_curl -H 'Accept: application/octet-stream' -o "$archive" "$archive_url"
github_curl -H 'Accept: application/octet-stream' -o "$stage/$archive_name.sha256" "$sha_url"
github_curl -H 'Accept: application/octet-stream' -o "$stage/formaliscope-app-manifest.json" "$manifest_url"

(cd "$stage" && sha256sum -c "$archive_name.sha256")
python3 "$RELEASE_HELPER" validate "$stage/formaliscope-app-manifest.json" "$tag" "$archive_name" "$commit" "$archive"

tar --list --file "$archive" | python3 -c '
import sys
for name in sys.stdin:
    name = name.rstrip("\n")
    if name.startswith("/") or ".." in name.split("/"):
        raise SystemExit(f"unsafe archive member: {name}")
'
release_stage="$stage/release"
mkdir "$release_stage"
tar --extract --gzip --file "$archive" --directory "$release_stage" --strip-components=1
[[ -f "$release_stage/review_app/__main__.py" ]] || { echo "archive has no review_app" >&2; exit 1; }
python3 -m py_compile "$release_stage"/review_app/*.py

release_dir="$RELEASES/$commit"
if [[ -e "$release_dir" ]]; then
  echo "release directory already exists but is not active: $release_dir" >&2
  exit 1
fi
mv "$release_stage" "$release_dir"

# Back up before stopping the old process. Use its CLI directly: an installed
# backup helper may already expect options that this older release lacks.
# Keep this pre-upgrade backup without applying retention during activation.
backup_created=0
if [[ -f "$DATA_DIR/judgments.sqlite3" ]]; then
  [[ -f "$DATA_DIR/snapshot.json" ]] || { echo "existing review database has no snapshot; restore the snapshot before upgrading" >&2; exit 1; }
  backup_application="${current_target:-$release_dir}"
  if ! runuser -u formaliscope-review -- env PYTHONPATH="$backup_application" REVIEW_DATA_DIR="$DATA_DIR" \
    python3 -m review_app backup --data-dir "$DATA_DIR" --output "$BACKUP_DIR"; then
    echo "pre-upgrade backup failed; application and running review service were not changed" >&2
    exit 1
  fi
  backup_created=1
fi

# Read named properties: systemctl's output order is not an interface guarantee.
read_review_state() {
  local details status=0 key value
  details="$(systemctl show --property=LoadState --property=ActiveState formaliscope-review.service)" || status=$?
  review_load_state=""
  review_active_state=""
  while IFS='=' read -r key value; do
    case "$key" in
      LoadState) review_load_state="$value" ;;
      ActiveState) review_active_state="$value" ;;
    esac
  done <<<"$details"
  [[ "$review_load_state" == not-found ]] && return 0
  if [[ "$status" != 0 || -z "$review_load_state" || -z "$review_active_state" ]]; then
    echo "could not read review service state; migration and activation aborted" >&2
    return 1
  fi
}

# Schema changes can rename columns used by the old release. Stop every
# installed review unit, including a queued automatic restart or a process
# still starting/stopping. Only previously running/starting units are resumed.
review_should_restart=0
read_review_state
if [[ "$review_load_state" != not-found ]]; then
  case "$review_active_state" in
    active|activating|reloading) review_should_restart=1 ;;
    inactive|failed|deactivating) ;;
    *) echo "unexpected review service state: $review_active_state; migration and activation aborted" >&2; exit 1 ;;
  esac
  if ! systemctl stop formaliscope-review.service; then
    echo "could not stop the review service; migration and activation aborted" >&2
    exit 1
  fi
  read_review_state
  case "$review_active_state" in
    inactive|failed) ;;
    *) echo "review service did not stop (ActiveState=$review_active_state); migration and activation aborted" >&2; exit 1 ;;
  esac
fi

# No snapshot on a first install: the snapshot puller initializes the data before
# an operator starts the review service. A failed migration may have committed
# earlier migration steps, so never automatically restart the previous code.
if [[ -f "$DATA_DIR/snapshot.json" ]]; then
  if ! runuser -u formaliscope-review -- env PYTHONPATH="$release_dir" REVIEW_DATA_DIR="$DATA_DIR" \
    python3 -m review_app migrate --data-dir "$DATA_DIR"; then
    echo "application migration failed; current was not switched and the review service remains stopped" >&2
    if [[ "$backup_created" == 1 ]]; then
      echo "pre-upgrade backups are retained in $BACKUP_DIR; restore the matching backup before starting the previous release against this database" >&2
    else
      echo "no pre-upgrade database existed; inspect the migration error before explicitly starting a release" >&2
    fi
    exit 1
  fi
fi

ln -sfn "$release_dir" "$ROOT/current.new"
mv -Tf "$ROOT/current.new" "$ROOT/current"
if [[ "$review_should_restart" == 1 ]]; then
  systemctl restart formaliscope-review.service
  ready=0
  for attempt in {1..15}; do
    if curl --fail --silent --max-time 2 http://127.0.0.1:8765/healthz | \
      python3 -c 'import json,sys; raise SystemExit(0 if json.load(sys.stdin).get("ready") is True else 1)' 2>/dev/null; then
      ready=1
      break
    fi
    sleep 1
  done
  [[ "$ready" == 1 ]] || { echo "application readiness failed; use the documented rollback procedure" >&2; exit 1; }
fi
echo "activated application $tag"
if [[ "$review_should_restart" == 0 ]]; then
  echo "review service remains inactive; start it explicitly after installing and checking the snapshot"
fi
