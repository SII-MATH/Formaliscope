#!/usr/bin/env bash
# Pull and activate the latest immutable Formaliscope application release.
# The GitHub token is read from a root-only file and is never printed.
set -Eeuo pipefail

REPOSITORY="${FORMALISCOPE_GITHUB_REPOSITORY:-SII-MATH/Formaliscope}"
TOKEN_FILE="${FORMALISCOPE_GITHUB_TOKEN_FILE:-/etc/formaliscope/github-read-token}"
ROOT="${FORMALISCOPE_ROOT:-/opt/formaliscope}"
RELEASES="$ROOT/releases"
DATA_DIR="${REVIEW_DATA_DIR:-/var/lib/formaliscope}"
LOCK_FILE="${FORMALISCOPE_DEPLOY_LOCK:-/run/lock/formaliscope-deploy.lock}"
API="https://api.github.com/repos/${REPOSITORY}/releases?per_page=100"

[[ -r "$TOKEN_FILE" ]] || { echo "missing GitHub token file: $TOKEN_FILE" >&2; exit 1; }
install -d -m 0755 "$RELEASES" "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -n 9 || { echo "another Formaliscope deployment is running"; exit 0; }

token="$(<"$TOKEN_FILE")"
[[ -n "$token" ]] || { echo "GitHub token file is empty" >&2; exit 1; }
release_json="$(curl --fail --silent --show-error --location --retry 3 \
  -H 'Accept: application/vnd.github+json' \
  -H "Authorization: Bearer $token" \
  -H 'X-GitHub-Api-Version: 2022-11-28' "$API")"

mapfile -t release_info < <(python3 -c '
import json, re, sys
releases = json.load(sys.stdin)
chosen = None
for release in releases:
    tag = release.get("tag_name", "")
    if release.get("draft") or release.get("prerelease") or not re.fullmatch(r"app-[0-9a-f]{40}", tag):
        continue
    if chosen is None or (release.get("published_at") or release.get("created_at") or "") > (chosen.get("published_at") or chosen.get("created_at") or ""):
        chosen = release
if chosen is None:
    raise SystemExit("no immutable app release found")
assets = {asset["name"]: asset["browser_download_url"] for asset in chosen.get("assets", [])}
commit = chosen["tag_name"][4:]
archive = f"formaliscope-app-{commit}.tar.gz"
required = [archive, archive + ".sha256", "formaliscope-app-manifest.json"]
missing = [name for name in required if name not in assets]
if missing:
    raise SystemExit("release is missing assets: " + ", ".join(missing))
for value in (chosen["tag_name"], commit, archive, assets[archive], assets[archive + ".sha256"], assets["formaliscope-app-manifest.json"]):
    print(value)
' <<<"$release_json")

tag="${release_info[0]}"
commit="${release_info[1]}"
archive_name="${release_info[2]}"
archive_url="${release_info[3]}"
sha_url="${release_info[4]}"
manifest_url="${release_info[5]}"
current_target=""
if [[ -L "$ROOT/current" ]]; then
  current_target="$(readlink -f "$ROOT/current")"
fi
if [[ "$current_target" == "$RELEASES/$commit" ]]; then
  echo "application already active: $tag"
  exit 0
fi

stage="$(mktemp -d "$ROOT/.app-pull.XXXXXX")"
cleanup() { rm -rf "$stage"; }
trap cleanup EXIT
archive="$stage/$archive_name"
curl --fail --silent --show-error --location --retry 3 -H "Authorization: Bearer $token" -o "$archive" "$archive_url"
curl --fail --silent --show-error --location --retry 3 -H "Authorization: Bearer $token" -o "$stage/$archive_name.sha256" "$sha_url"
curl --fail --silent --show-error --location --retry 3 -H "Authorization: Bearer $token" -o "$stage/formaliscope-app-manifest.json" "$manifest_url"

(cd "$stage" && sha256sum -c "$archive_name.sha256")
python3 - "$stage/formaliscope-app-manifest.json" "$archive_name" "$commit" "$archive" <<'PY'
import json
import hashlib
import pathlib
import sys

manifest = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))
if manifest.get("schema") != "formaliscope-app-release.v1":
    raise SystemExit("unsupported application manifest schema")
if manifest.get("archive") != sys.argv[2] or manifest.get("commit") != sys.argv[3]:
    raise SystemExit("application manifest does not match the selected release")
if manifest.get("sha256") != hashlib.sha256(pathlib.Path(sys.argv[4]).read_bytes()).hexdigest():
    raise SystemExit("application manifest digest does not match archive")
PY

tar --list --file "$archive" | python3 -c '
import sys
for name in sys.stdin:
    name = name.rstrip("\n")
    if name.startswith("/") or ".." in name.split("/"):
        raise SystemExit(f"unsafe archive member: {name}")
'
release_stage="$stage/release"
mkdir "$release_stage"
tar --extract --gzip --file "$archive" --directory "$release_stage" --strip-components=1
[[ -f "$release_stage/review_app/__main__.py" ]] || { echo "archive has no review_app" >&2; exit 1; }
python3 -m py_compile "$release_stage"/review_app/*.py

release_dir="$RELEASES/$commit"
if [[ -e "$release_dir" ]]; then
  echo "release directory already exists but is not active: $release_dir" >&2
  exit 1
fi
mv "$release_stage" "$release_dir"

# The backup uses the currently active application, then the migration runs
# against persistent data with the new application before the code switch. It
# is deliberately skipped when there is no installed snapshot yet; the
# snapshot puller initializes the data directory before the first service
# start.
if [[ -f "$DATA_DIR/snapshot.json" ]]; then
  if [[ -f "$DATA_DIR/judgments.sqlite3" && -x /usr/local/sbin/formaliscope-review-backup ]]; then
    /usr/local/sbin/formaliscope-review-backup
  fi
  PYTHONPATH="$release_dir" REVIEW_DATA_DIR="$DATA_DIR" \
    python3 -m review_app migrate --data-dir "$DATA_DIR"
fi

ln -sfn "$release_dir" "$ROOT/current.new"
mv -Tf "$ROOT/current.new" "$ROOT/current"
if systemctl cat formaliscope-review.service >/dev/null 2>&1; then
  systemctl restart formaliscope-review.service
  curl --fail --silent --show-error --max-time 10 http://127.0.0.1:8765/login >/dev/null
fi
echo "activated application $tag"
