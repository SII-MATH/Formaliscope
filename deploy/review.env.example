REVIEW_MAILER=smtp
REVIEW_SMTP_HOST=smtp.example.org
REVIEW_SMTP_PORT=465
REVIEW_SMTP_SECURITY=ssl
REVIEW_SMTP_USER=sender@example.org
REVIEW_SMTP_FROM=sender@example.org
REVIEW_SMTP_PASSWORD_FILE=/etc/formaliscope/smtp-password
REVIEW_ALLOW_ANY_EMAIL=1
REVIEW_PUBLIC_ORIGIN=https://review.example.org
REVIEW_COOKIE_PATH=/
# Comma-separated verified-email identities admitted by the policy above.
REVIEW_ADMIN_EMAILS=admin@example.org
