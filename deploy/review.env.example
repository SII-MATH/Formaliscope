# Default: name registration, remembered browser identity, private recovery code.
# No SMTP, student roster, password or invitation code is required.
REVIEW_AUTH_MODE=name
REVIEW_PUBLIC_ORIGIN=https://review.example.org
REVIEW_COOKIE_PATH=/
# Before starting, run create-admin with a NEW private recovery file.
# See review_app/IDENTITY.md. Legacy email deployments must explicitly set
# REVIEW_AUTH_MODE=email and retain their old SMTP/admission settings.
